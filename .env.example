# Database Configuration
DATABASE_URL=sqlite:///./social_listening.db
# For PostgreSQL use: postgresql://user:password@localhost/dbname

# API Keys (replace with your actual keys)
META_API_KEY=your_meta_api_key_here
META_API_SECRET=your_meta_api_secret_here
META_FB_ACCESS_TOKEN=your_facebook_access_token_here
# Any others you might need for facebook

META_IG_ACCESS_TOKEN=your_instagram_access_token_here
INSTAGRAM_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id_here

X_API_KEY=your_x_api_key_here
X_API_SECRET=your_x_api_secret_here
X_BEARER_TOKEN=your_x_bearer_token_here

TRIPADVISOR_API_KEY=your_tripadvisor_api_key_here

# Application Settings
APP_NAME=Social Listening Platform
APP_VERSION=1.0.0
DEBUG=True
