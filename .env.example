# Database Configuration
DATABASE_URL=sqlite:///./social_listening.db
# For PostgreSQL use: postgresql://user:password@localhost/dbname

# API Keys (replace with your actual keys)

# Meta OAuth Configuration
META_APP_ID=your_meta_app_id_here
META_APP_SECRET=your_meta_app_secret_here
META_REDIRECT_URI=http://localhost:8000/auth/meta/callback
# META_ACCESS_TOKEN is auto-populated in database after OAuth flow - DO NOT SET HERE
# The long-lived token is encrypted and stored in the database, retrieved via MetaAuthService

# Encryption key for storing sensitive tokens in database (minimum 32 characters)
ENCRYPTION_KEY=your_32_character_encryption_key_minimum_here

TRIPADVISOR_API_KEY=your_tripadvisor_api_key_here

# Application Settings
APP_NAME=Social Listening Platform
APP_VERSION=1.0.0
DEBUG=True

